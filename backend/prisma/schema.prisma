
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SCORER
}

enum TournamentStatus {
  DRAFT
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum PlayerRole {
  BATTER
  BOWLER
  ALL_ROUNDER
  WICKET_KEEPER
}
enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  ABANDONED
  CANCELLED
}

enum MatchFormat {
  T10
  T20
  ODI
  TEST
  CUSTOM
}

enum TossDecision {
  BAT
  FIELD
}

enum InningsStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DECLARED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SCORER)

  tournaments  Tournament[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Tournament {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  description String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  status      TournamentStatus @default(DRAFT)

  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  teams       TournamentTeam[]
  matches Match[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("tournaments")
}

model Team {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  shortName String
  logo      String?

  players      TeamPlayer[]
  tournaments  TournamentTeam[]
  homeMatches Match[] @relation("MatchTeamA")
awayMatches Match[] @relation("MatchTeamB")
tossWins    Match[] @relation("MatchTossWinner")
battingInnings Innings[] @relation("InningsBattingTeam")
bowlingInnings Innings[] @relation("InningsBowlingTeam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

model Player {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  profileImage String?
  role         PlayerRole?

  teams        TeamPlayer[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("players")
}

model TeamPlayer {
  id           String @id @default(uuid()) @db.Uuid
  teamId       String @db.Uuid
  playerId     String @db.Uuid
  jerseyNumber Int?

  team         Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player       Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  joinedAt     DateTime @default(now())

  @@unique([teamId, playerId])
  @@index([playerId])
  @@map("team_players")
}

model TournamentTeam {
  id           String @id @default(uuid()) @db.Uuid
  tournamentId String @db.Uuid
  teamId       String @db.Uuid

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  registeredAt DateTime @default(now())

  @@unique([tournamentId, teamId])
  @@index([teamId])
  @@map("tournament_teams")
}
model Match {
  id           String      @id @default(uuid()) @db.Uuid
  name         String?
  format       MatchFormat @default(T20)
  status       MatchStatus @default(SCHEDULED)

  // Match configuration
  totalOvers   Int         @default(20)
  venue        String?
  scheduledAt  DateTime?

  // Tournament
  tournamentId String     @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // Participating teams
  teamAId      String @db.Uuid
  teamBId      String @db.Uuid

  teamA        Team @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamB        Team @relation("MatchTeamB", fields: [teamBId], references: [id])

  // Toss
  tossWinnerId String?      @db.Uuid
  tossWinner   Team?        @relation("MatchTossWinner", fields: [tossWinnerId], references: [id])
  tossDecision TossDecision?

  // Innings
  innings      Innings[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tournamentId])
  @@index([status])
  @@index([scheduledAt])
  @@map("matches")
}
model Innings {
  id             String       @id @default(uuid()) @db.Uuid

  matchId        String       @db.Uuid
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)

  inningsNumber  Int

  battingTeamId  String       @db.Uuid
  bowlingTeamId  String       @db.Uuid

  battingTeam    Team         @relation("InningsBattingTeam", fields: [battingTeamId], references: [id])
  bowlingTeam    Team         @relation("InningsBowlingTeam", fields: [bowlingTeamId], references: [id])

  status         InningsStatus @default(NOT_STARTED)

  // Current score summary
  runs           Int          @default(0)
  wickets        Int          @default(0)

  // Number of legal balls bowled
  legalBalls     Int          @default(0)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([matchId, inningsNumber])
  @@index([matchId])
  @@map("innings")
}